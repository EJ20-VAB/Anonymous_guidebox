<%= form_with(model: feedback) do |form| %>
  <% if feedback.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(feedback.errors.count, "error") %> prohibited this feedback from being saved:</h2>

      <ul>
        <% feedback.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# カテゴリ選択用のプルダウンメニューを追加 %>
  <div>
    <%= form.label :category, style: "display: block" %>
    <%= form.select :category, ["改善案", "相談", "報告", "その他"], { include_blank: "選択してください" }, { required: true } %>
  </div>

  <div>
    <%= form.label :content, style: "display: block" %>
    <%= form.text_area :content %>
  </div>

<div>
  <%= form.label :status, "対応ステータス", style: "display: block" %>
  <%= form.select :status, ["未対応", "対応中", "完了"], {}, { class: "form-control" } %>
</div>

  <div>
    <%= form.submit "フィードバックを送信する" %>
  </div>
<% end %>
