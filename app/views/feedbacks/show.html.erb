<p style="color: green"><%= notice %></p>

<%= render @feedback %>

<div>
  <%= link_to "編集する", edit_feedback_path(@feedback) %> |
  <%= link_to "一覧に戻る", feedbacks_path %>

  <div style="margin-top: 20px;">
    <%= button_to "この投稿を削除する", @feedback, method: :delete, data: { confirm: "本当に削除しますか？" }, class: "delete-btn" %>
  </div>
</div>
